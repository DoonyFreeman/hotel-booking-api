{
  "id": null,
  "title": "FastAPI Metrics",
  "tags": ["fastapi", "booking"],
  "timezone": "browser",
  "panels": [
    {
      "title": "RPS",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(http_requests_total[1m])",
          "legendFormat": "{{method}} {{path}} {{status}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "title": "P50 / P95 / P99 Latency",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p99"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "title": "Status Codes Breakdown",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=~\"2..\"}[1m]))",
          "legendFormat": "2xx"
        },
        {
          "expr": "sum(rate(http_requests_total{status=~\"4..\"}[1m]))",
          "legendFormat": "4xx"
        },
        {
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[1m]))",
          "legendFormat": "5xx"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "title": "Active Requests",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "http_requests_in_progress",
          "legendFormat": "active"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    },
    {
      "title": "Bookings Created",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "bookings_created_total",
          "legendFormat": "total"
        }
      ],
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 16 }
    },
    {
      "title": "Users Registered",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "users_registered_total",
          "legendFormat": "total"
        }
      ],
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 16 }
    },
    {
      "title": "Bookings Cancelled",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "bookings_cancelled_total",
          "legendFormat": "total"
        }
      ],
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 16 }
    }
  ],
  "schemaVersion": 36,
  "version": 1
}
